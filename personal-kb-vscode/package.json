{
  "name": "personal-kb",
  "displayName": "Personal KB 卡片墙",
  "description": "和 AI 聊出来的灵感和结论，说一句「沉淀本次」就存成知识卡片，替你攒出自己的知识库。",
  "version": "0.3.3",
  "publisher": "Rebekah",
  "license": "MIT",
  "icon": "media/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rebecia/rebekah-s-home.git",
    "directory": "personal-kb-vscode"
  },
  "bugs": {
    "url": "https://github.com/Rebecia/rebekah-s-home/issues"
  },
  "homepage": "https://github.com/Rebecia/rebekah-s-home/tree/main/personal-kb-vscode#readme",
  "galleryBanner": {
    "color": "#15171B",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other",
    "Notebooks"
  ],
  "keywords": [
    "markdown",
    "notes",
    "knowledge",
    "cards",
    "zettelkasten",
    "second-brain",
    "obsidian",
    "personal-kb",
    "第二大脑",
    "知识库",
    "卡片笔记"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "personalKb",
          "title": "Personal KB",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "personalKb": [
        {
          "id": "personalKb.stats",
          "name": "统计",
          "type": "webview"
        },
        {
          "id": "personalKb.cards",
          "name": "卡片",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "personalKb.openWall",
        "title": "Personal KB: 打开卡片墙",
        "icon": "$(symbol-color)"
      },
      {
        "command": "personalKb.refresh",
        "title": "Personal KB: 刷新卡片",
        "icon": "$(refresh)"
      },
      {
        "command": "personalKb.openCard",
        "title": "Personal KB: 打开卡片原文"
      },
      {
        "command": "personalKb.linkObsidian",
        "title": "Personal KB: 连接到 Obsidian vault"
      },
      {
        "command": "personalKb.unlinkObsidian",
        "title": "Personal KB: 取消 Obsidian 连接"
      },
      {
        "command": "personalKb.pickKbFolder",
        "title": "Personal KB: 选择卡片目录",
        "icon": "$(folder-opened)"
      },
      {
        "command": "personalKb.createSampleCard",
        "title": "Personal KB: 创建示例卡片"
      },
      {
        "command": "personalKb.connectAgents",
        "title": "Personal KB: 接入 AI 助手（开启自动沉淀）"
      },
      {
        "command": "personalKb.disconnectAgents",
        "title": "Personal KB: 移除 AI 助手的沉淀指令"
      },
      {
        "command": "personalKb.migrateLegacy",
        "title": "Personal KB: 从旧位置复制卡片"
      },
      {
        "command": "personalKb.revealKb",
        "title": "Personal KB: 在文件管理器中显示卡片目录"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "personalKb.refresh",
          "when": "view == personalKb.cards || view == personalKb.stats",
          "group": "navigation"
        },
        {
          "command": "personalKb.openWall",
          "when": "view == personalKb.cards || view == personalKb.stats",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "personalKb.openCard",
          "when": "view == personalKb.cards"
        }
      ]
    },
    "configuration": {
      "title": "Personal KB",
      "properties": {
        "personalKb.kbPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "卡片目录：一个装着 Markdown 卡片的文件夹，可以有子目录。留空则用默认位置 `~/Personal-KB/`。"
        },
        "personalKb.obsidianVault": {
          "type": "string",
          "default": "",
          "description": "Obsidian vault 根目录。连接后会在其中创建指向 kb/ 的软链 Personal-KB。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "tsc -p ./ && node --test \"out/test/*.test.js\"",
    "icon": "node scripts/make-icon.mjs",
    "demo": "node scripts/make-demo.mjs",
    "shots": "node scripts/shots.mjs",
    "serve": "python3 -m http.server 8080 --directory docs/demo",
    "package": "vsce package --no-dependencies",
    "copy": "node scripts/apply-copy.mjs && node scripts/make-demo.mjs",
    "release": "node scripts/prepare-release.mjs",
    "release:patch": "node scripts/prepare-release.mjs patch",
    "release:minor": "node scripts/prepare-release.mjs minor",
    "release:major": "node scripts/prepare-release.mjs major",
    "ship:patch": "node scripts/prepare-release.mjs patch --publish",
    "ship:minor": "node scripts/prepare-release.mjs minor --publish",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "3.2.1",
    "typescript": "5.6.3"
  }
}
